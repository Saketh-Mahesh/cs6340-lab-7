{
    "name": "KLEE Lab Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--ulimit", "stack=-1:-1",
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],
    "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
    },
    "remoteUser": "klee",
    "mounts": [
        // This maps your repo code to the /home/klee/klee folder 
        // expected by your lab guides
        "source=${localWorkspaceFolder}/klee,target=/home/klee/klee,type=bind"
    ]
}
